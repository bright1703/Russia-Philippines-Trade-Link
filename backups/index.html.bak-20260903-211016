  <script>
    (() => {
      const buttons = [...document.querySelectorAll('[data-filter]')];
      const cards = [...document.querySelectorAll('.opportunity-card')];
      buttons.forEach((button) => button.addEventListener('click', () => {
        const filter = button.dataset.filter;
        buttons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        cards.forEach((card) => {
          const categories = card.dataset.categories.split(' ');
          card.classList.toggle('is-hidden', filter !== 'all' && !categories.includes(filter));
        });
      }));

      const inquiryForm = document.querySelector('#inquiry-form');
      inquiryForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        const values = Object.fromEntries(new FormData(inquiryForm).entries());
        const body = [
          `Inquiry type: ${values['Inquiry type'] || ''}`,
          `Company: ${values.Company || ''}`,
          `Contact: ${values.Contact || ''}`,
          `Product or category: ${values.Product || ''}`,
          `Required volume: ${values.Volume || ''}`,
          '',
          `Message: ${values.Message || ''}`
        ].join('\n');
        const subject = `${values['Inquiry type'] || 'Business inquiry'}: ${values.Product || 'new request'}`;
        window.location.href = `mailto:rus.import.ph@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      });
    })();
