# Скопируйте в .env и заполните реальными значениями.
# .env НИКОГДА не коммитится (см. .gitignore).

# https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Генерируется ОДИН РАЗ локально: python generate_session.py
# Это эквивалент пароля от Telegram-аккаунта — храните как секрет,
# не публикуйте, не отправляйте в чат.
TELEGRAM_SESSION_STRING=
