# Альтернатива systemd. Время сервера — UTC.
# Логи пишутся в /opt/trade-agent/logs, поэтому вывод глушим.
30 5 * * *  cd /opt/trade-agent && .venv/bin/python -m trade_agent.fetch   >/dev/null 2>&1
0  6 * * *  cd /opt/trade-agent && .venv/bin/python -m trade_agent.process >/dev/null 2>&1
30 6 * * *  cd /opt/trade-agent && .venv/bin/python -m trade_agent.digest  >/dev/null 2>&1
