[Unit]
Description=Trade Agent — два выпуска в неделю (понедельник и четверг)

[Timer]
# Время сервера не меняется: зона указана явно только для этого таймера.
# Проверить следующие срабатывания перед включением:
#   systemd-analyze calendar --iterations=6 'Mon,Thu 08:00 Asia/Manila'
OnCalendar=Mon,Thu 08:00 Asia/Manila
# Persistent=true догоняет пропущенный запуск после простоя сервера.
# Несколько старых выпусков подряд при этом не рассылаются: systemd
# выполняет один догоняющий старт, а сам прогон добирает пропущенный
# интервал сбора и ограничен двумя автоматическими циклами в неделю.
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
