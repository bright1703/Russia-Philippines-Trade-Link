# Скопируйте в .env и заполните. Файл .env в Git не попадает.

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL_FAST=claude-haiku-4-5-20251001
LLM_MODEL_DEEP=claude-sonnet-5
LLM_MAX_INPUT_CHARS=24000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_TIMEOUT=90
LLM_RETRIES=3
LLM_MAX_CALLS_PER_RUN=200

# --- Telegram Bot (доставка результатов) -------------------------------
TELEGRAM_BOT_TOKEN=
# один или несколько id через запятую — кому бот отвечает
TELEGRAM_ALLOWED_USER_ID=
# Необязательно: дополнительное ограничение по чатам.
# Пусто — разрешён только личный чат владельца; группы и каналы
# игнорируются в любом случае.
TELEGRAM_ALLOWED_CHAT_ID=
# Файл с offset обновлений (по умолчанию data/bot_offset.json)
TELEGRAM_OFFSET_FILE=
TELEGRAM_UPDATES_LIMIT=20

# --- Telegram-аккаунт (сбор данных, read-only) -------------------------
# Нужны только для режима telegram.mode=telethon в sources.yml
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- Пороги конвейера --------------------------------------------------
SCOUT_MIN_SCORE=2
ANALYST_MIN_SCORE=3
REVIEWER_MAX_REVISIONS=2
RADAR_MIN_MATCH_SCORE=2
DIGEST_LOOKBACK_DAYS=1
DIGEST_MIN_CONFIDENCE=0.4
DIGEST_MAX_PER_SECTION=8
FETCH_DAYS=7
